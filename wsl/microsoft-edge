#!/usr/bin/env python3
"""Expose Windows Edge to WSL browser discovery and fixed CLI screenshots."""
from __future__ import annotations
import os
import signal
import subprocess
import sys
from pathlib import Path
from urllib.parse import unquote, urlparse
EDGE_CANDIDATES = (
    "/mnt/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe",
    "/mnt/c/Program Files/Microsoft/Edge/Application/msedge.exe",
)
PATH_OPTIONS = ("--screenshot=", "--user-data-dir=")
def edge_path() -> str:
    configured = os.environ.get("DSH_WSL_EDGE_EXE", "").strip()
    if configured and Path(configured).is_file(): return configured
    for candidate in EDGE_CANDIDATES:
        if Path(candidate).is_file(): return candidate
    raise FileNotFoundError("Windows Edge was not found under /mnt/c/Program Files*")
def to_windows_path(value: str) -> str:
    result = subprocess.run(["wslpath", "-w", str(Path(value).expanduser().resolve())], check=True, capture_output=True, text=True)
    return result.stdout.strip()
def translate(arg: str) -> str:
    for prefix in PATH_OPTIONS:
        if arg.startswith(prefix): return prefix + to_windows_path(arg[len(prefix):])
    if arg.startswith("file://"):
        parsed = urlparse(arg)
        if parsed.netloc in ("", "localhost"): return to_windows_path(unquote(parsed.path))
    return arg
def main() -> int:
    process = subprocess.Popen([edge_path(), *(translate(arg) for arg in sys.argv[1:])], stdin=subprocess.DEVNULL)
    def forward(_signum, _frame):
        if process.poll() is None: process.terminate()
    signal.signal(signal.SIGTERM, forward)
    signal.signal(signal.SIGINT, forward)
    return process.wait()
if __name__ == "__main__": raise SystemExit(main())
